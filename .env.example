# Copia este archivo como .env (en local) o carga estas variables en Hostinger.
# No subas el archivo .env a GitHub.

# mysql://USUARIO:CONTRASEÑA@HOST:3306/BASE
DATABASE_URL="mysql://usuario:contraseña@localhost:3306/crv4"

# Primer administrador. Se crea al arrancar si todavía no existe ningún admin.
SEED_ADMIN_USUARIO="admin"
SEED_ADMIN_PASSWORD="cambia-esta-contraseña"

# Opcional. Carpeta donde se guardan las fotos de productos, fuera de lo que se
# publica (si no se indica: la carpeta "imagenes" del usuario, ej. /home/u123/imagenes).
# CARPETA_IMAGENES="/home/usuario/imagenes"
